# Reddit API Credentials (REQUIRED)
# Get these from: https://www.reddit.com/prefs/apps
# Create a "script" app to get client_id and client_secret
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=ScamURLCollector/1.0

# Twitter API Credentials (OPTIONAL - only needed if using --twitter-api flag)
# Get these from: https://developer.twitter.com/en/portal/dashboard
# Free tier is very limited; snscrape is recommended instead
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# Database Configuration
DATABASE_PATH=scam_url_collector/data/scam_urls.db

# Rate Limiting Configuration
REQUESTS_PER_MINUTE=30
SLEEP_BETWEEN_REQUESTS=2.0

# URL Validation Configuration
TIMEOUT_SECONDS=5
MAX_REDIRECTS=3
CHECK_URL_ACCESSIBILITY=false

# Scraping Configuration
# Reddit settings
REDDIT_POST_LIMIT=100
REDDIT_DAYS_BACK=7

# Twitter settings
TWITTER_TWEET_LIMIT=100
TWITTER_DAYS_BACK=7

# BBB settings
BBB_PAGES_TO_SCRAPE=10

# FTC settings
FTC_DAYS_BACK=30

# Browser Configuration (for BBB scraping)
HEADLESS_BROWSER=true
BROWSER_TYPE=chromium

# Scheduling Configuration
COLLECTION_INTERVAL_HOURS=6

# Export Configuration
EXPORT_LIMIT=500
EXPORT_PATH=scam_url_collector/data/urls_to_investigate.json
