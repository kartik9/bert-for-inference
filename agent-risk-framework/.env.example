# API Keys - Standard OpenAI
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Azure OpenAI Configuration
# Set USE_AZURE_OPENAI=true to use Azure OpenAI instead of standard OpenAI
USE_AZURE_OPENAI=false
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ChatGPT Web-based Testing (for REAL GPT Store agents)
# Set USE_WEB_TESTING=true to test actual GPTs with their real configurations
USE_WEB_TESTING=false
CHATGPT_EMAIL=your_chatgpt_email@example.com
CHATGPT_PASSWORD=your_chatgpt_password_here
WEB_TESTING_HEADLESS=true

# Browser-Use Cloud Service (RECOMMENDED for real GPT testing)
# Provides stealth browser automation with Cloudflare bypass
# Get API key from: https://cloud.browser-use.com/new-api-key
# New accounts get $10 free credits
BROWSER_USE_API_KEY=your_browser_use_api_key_here
BROWSER_USE_HEADLESS=true
BROWSER_USE_TIMEOUT=30000

# Application Settings
ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./agent_assessments.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Security
API_KEY_ENABLED=false
API_KEY=your_api_key_here

# Scoring Weights (override defaults)
WEIGHT_SECURITY=0.25
WEIGHT_PRIVACY=0.20
WEIGHT_RELIABILITY=0.20
WEIGHT_TRANSPARENCY=0.15
WEIGHT_AUTONOMY=0.20
