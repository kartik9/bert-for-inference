# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Application Settings
ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./agent_assessments.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Security
API_KEY_ENABLED=false
API_KEY=your_api_key_here

# Scoring Weights (override defaults)
WEIGHT_SECURITY=0.25
WEIGHT_PRIVACY=0.20
WEIGHT_RELIABILITY=0.20
WEIGHT_TRANSPARENCY=0.15
WEIGHT_AUTONOMY=0.20
