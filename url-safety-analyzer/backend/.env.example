# AI API Configuration
# Set ONE of the following API keys:

# OpenAI API Key (for GPT-4)
OPENAI_API_KEY=your_openai_api_key_here

# OR

# Anthropic API Key (for Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Web Search API Configuration
# Set ONE of the following for web reputation search:

# Brave Search API (Recommended - best free tier)
# Get key at: https://api.search.brave.com/
BRAVE_SEARCH_API_KEY=your_brave_api_key_here

# OR SerpAPI
# Get key at: https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# OR Google Custom Search API
# Get key at: https://developers.google.com/custom-search/v1/overview
GOOGLE_CSE_API_KEY=your_google_cse_api_key_here
GOOGLE_CSE_ID=your_search_engine_id_here

# Application Settings
DEBUG=False
LOG_LEVEL=INFO
