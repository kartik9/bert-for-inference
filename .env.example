# Trust & Safety Newsletter Automation - Environment Variables
# Copy this file to .env and fill in your API keys

# === LLM Configuration ===
# Choose ONE of the following options:

# Option 1: Azure OpenAI (recommended for enterprise)
AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=your_azure_api_key_here

# Option 2: Standard OpenAI (if not using Azure)
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxx

# Optional: Bing Search API Key (when switching from DuckDuckGo)
BING_SEARCH_API_KEY=your_bing_api_key_here

# Database
POSTGRES_PASSWORD=your_secure_password_here

# Optional: Internal Microsoft APIs
AURORA_API_KEY=your_aurora_api_key
INCIDENT_API_KEY=your_incident_api_key

# Optional: Override config file path
TS_NEWSLETTER_CONFIG=./ts_newsletter/config.yaml
